{
  "name": "@fifo/convee",
  "version": "2.1.0",
  "exports": "./src/index.ts",
  "imports": {
    "@/": "./src/",
    "@convee": "./src/index.ts",
    "@test/": "./test/",
    "std/": "https://deno.land/std@0.224.0/",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/testing": "jsr:@std/testing@^1.0.0"
  },
  "tasks": {
    "check": "deno check src/index.ts test/types/*.test.ts tools/*.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "docs": "deno doc --lint src/index.ts",
    "test": "deno test --clean --parallel --coverage=coverage src test/*.integration.test.ts test/regressions test/concurrency test/properties test/fixtures",
    "test:unit": "deno test src",
    "test:integration": "deno test test/*.integration.test.ts",
    "test:types": "deno check test/types/*.test.ts",
    "test:tooling": "deno test tools/*.test.ts",
    "test:architecture": "deno test --allow-env=TSC_WATCHFILE,TSC_WATCHDIRECTORY,TSC_NONPOLLING_WATCHER,NODE_INSPECTOR_IPC,VSCODE_INSPECTOR_OPTIONS,NODE_ENV,TSC_WATCH_POLLINGINTERVAL_LOW,TSC_WATCH_POLLINGINTERVAL_MEDIUM,TSC_WATCH_POLLINGINTERVAL_HIGH,TSC_WATCH_POLLINGCHUNKSIZE_LOW,TSC_WATCH_POLLINGCHUNKSIZE_MEDIUM,TSC_WATCH_POLLINGCHUNKSIZE_HIGH,TSC_WATCH_UNCHANGEDPOLLTHRESHOLDS_LOW,TSC_WATCH_UNCHANGEDPOLLTHRESHOLDS_MEDIUM,TSC_WATCH_UNCHANGEDPOLLTHRESHOLDS_HIGH --allow-read=src,test/fixtures,deno.json test/architecture",
    "test:depth": "deno run --allow-read --allow-write=.artifacts --allow-run=deno tools/type-depth.ts",
    "test:stress": "deno test test/properties -- --stress",
    "test:mutation": "deno run --allow-env=TSC_WATCHFILE,TSC_WATCHDIRECTORY,TSC_NONPOLLING_WATCHER,NODE_INSPECTOR_IPC,VSCODE_INSPECTOR_OPTIONS,NODE_ENV,TSC_WATCH_POLLINGINTERVAL_LOW,TSC_WATCH_POLLINGINTERVAL_MEDIUM,TSC_WATCH_POLLINGINTERVAL_HIGH,TSC_WATCH_POLLINGCHUNKSIZE_LOW,TSC_WATCH_POLLINGCHUNKSIZE_MEDIUM,TSC_WATCH_POLLINGCHUNKSIZE_HIGH,TSC_WATCH_UNCHANGEDPOLLTHRESHOLDS_LOW,TSC_WATCH_UNCHANGEDPOLLTHRESHOLDS_MEDIUM,TSC_WATCH_UNCHANGEDPOLLTHRESHOLDS_HIGH --allow-read --allow-write=.artifacts --allow-run=deno tools/mutation.ts",
    "coverage": "deno coverage --lcov coverage > coverage.lcov && deno run --allow-env=TSC_WATCHFILE,TSC_WATCHDIRECTORY,TSC_NONPOLLING_WATCHER,NODE_INSPECTOR_IPC,VSCODE_INSPECTOR_OPTIONS,NODE_ENV,TSC_WATCH_POLLINGINTERVAL_LOW,TSC_WATCH_POLLINGINTERVAL_MEDIUM,TSC_WATCH_POLLINGINTERVAL_HIGH,TSC_WATCH_POLLINGCHUNKSIZE_LOW,TSC_WATCH_POLLINGCHUNKSIZE_MEDIUM,TSC_WATCH_POLLINGCHUNKSIZE_HIGH,TSC_WATCH_UNCHANGEDPOLLTHRESHOLDS_LOW,TSC_WATCH_UNCHANGEDPOLLTHRESHOLDS_MEDIUM,TSC_WATCH_UNCHANGEDPOLLTHRESHOLDS_HIGH --allow-read=src,coverage.lcov --allow-write=.artifacts tools/quality.ts",
    "bench": "mkdir -p .artifacts && deno bench --json bench > .artifacts/bench.json",
    "package:check": "deno publish --dry-run --allow-dirty",
    "verify": "deno fmt --check && deno lint && deno task check && deno task docs && deno task docs:examples && deno task test:types && deno task test:tooling && deno task test && deno task test:architecture && deno task test:depth && deno task coverage && deno task test:consumer && deno task package:check",
    "docs:examples": "deno run --allow-read=README.md,deno.json --allow-write=.artifacts/docs --allow-run=deno tools/docs-examples.ts",
    "test:consumer": "deno run --allow-env=TSC_WATCHFILE,TSC_WATCHDIRECTORY,TSC_NONPOLLING_WATCHER,NODE_INSPECTOR_IPC,VSCODE_INSPECTOR_OPTIONS,NODE_ENV,TSC_WATCH_POLLINGINTERVAL_LOW,TSC_WATCH_POLLINGINTERVAL_MEDIUM,TSC_WATCH_POLLINGINTERVAL_HIGH,TSC_WATCH_POLLINGCHUNKSIZE_LOW,TSC_WATCH_POLLINGCHUNKSIZE_MEDIUM,TSC_WATCH_POLLINGCHUNKSIZE_HIGH,TSC_WATCH_UNCHANGEDPOLLTHRESHOLDS_LOW,TSC_WATCH_UNCHANGEDPOLLTHRESHOLDS_MEDIUM,TSC_WATCH_UNCHANGEDPOLLTHRESHOLDS_HIGH --allow-read=src,test/fixtures --allow-write=.artifacts/package-consumer --allow-run=deno tools/package-consumer.ts",
    "test:resources": "deno test --v8-flags=--expose-gc test/resources"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "README.md",
      "TESTING.md",
      "LICENSE",
      "deno.json"
    ],
    "exclude": [
      "**/*.test.ts"
    ]
  },
  "lint": {
    "include": [
      "src/",
      "test/",
      "tools/",
      "bench/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "ban-untagged-todo"
      ]
    }
  },
  "compilerOptions": {
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "fmt": {
    "exclude": [
      ".artifacts",
      "coverage"
    ]
  }
}
