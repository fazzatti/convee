    export echo-choice: func(value: choice) -> choice;
    export echo-packet: func(value: packet) -> packet;
    export inspect-packet: func(value: packet) -> string;
    export through-host: func(value: packet) -> packet;
    export echo-tuple: func(value: tuple<s64, string, bool, list<u16>>) -> tuple<s64, string, bool, list<u16>>;
    export echo-nested: func(value: list<list<point>>) -> list<list<point>>;
    export echo-option: func(value: option<option<string>>) -> option<option<string>>;
    export echo-result: func(value: result<option<string>, choice>) -> result<option<string>, choice>;
    export result-ok: func(fail: bool) -> result<u32>;
    export result-err: func(fail: bool) -> result<_, string>;
    export result-unit: func(fail: bool) -> result;
    export echo-identifier: func(value: identifier) -> identifier;
    export char-code: func(value: char) -> u32;
    export string-codes: func(value: string) -> list<u32>;
    export bits-f32: func(value: f32) -> u32;
    export bits-f64: func(value: f64) -> u64;
    export no-args: func() -> string;
    export no-result: func();
    export flat-16: func(a0: u32, a1: u32, a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32, a8: u32, a9: u32, a10: u32, a11: u32, a12: u32, a13: u32, a14: u32, a15: u32) -> u32;
