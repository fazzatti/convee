    variant scalar-value { u32-value(u32), s32-value(s32), f32-value(f32), u64-value(u64), s64-value(s64), f64-value(f64) }
    record aligned { a: u8, b: u64, c: u16, d: s32, e: f32, f: s8, g: f64, h: s16, enabled: bool }
    export echo-scalar-value: func(value: scalar-value) -> scalar-value;
    export inspect-scalar-value: func(value: scalar-value) -> string;
    export echo-aligned: func(value: aligned) -> aligned;
    export list-aligned: func(value: list<aligned>) -> list<aligned>;
    export enum-256: func(value: enum-256) -> enum-256;
    export enum-257: func(value: enum-257) -> enum-257;
    enum shade { red, green, blue }
    record point { x: s32, label: string }
    variant choice { none, number(s64), text(string), points(list<point>) }
    type identifier = u64;
    record packet {
        id: identifier,
        name: string,
        enabled: bool,
        anchor: point,
        values: list<point>,
        choices: list<choice>,
        optional: option<option<string>>,
        verdicts: list<result<u32, string>>,
        pair: tuple<f64, string>,
        shade: shade,
        bytes: list<u8>,
    }
    flags flags-1 { b0 }
    flags flags-8 { b0, b1, b2, b3, b4, b5, b6, b7 }
    flags flags-9 { b0, b1, b2, b3, b4, b5, b6, b7, b8 }
    flags flags-16 { b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15 }
