    import observe: func(value: packet) -> packet;
    export echo-bool: func(value: bool) -> bool;
    export echo-u8: func(value: u8) -> u8;
    export echo-s8: func(value: s8) -> s8;
    export echo-u16: func(value: u16) -> u16;
    export echo-s16: func(value: s16) -> s16;
    export echo-u32: func(value: u32) -> u32;
    export echo-s32: func(value: s32) -> s32;
    export echo-u64: func(value: u64) -> u64;
    export echo-s64: func(value: s64) -> s64;
    export echo-f32: func(value: f32) -> f32;
    export echo-f64: func(value: f64) -> f64;
    export echo-char: func(value: char) -> char;
    export echo-string: func(value: string) -> string;
    export list-bool: func(value: list<bool>) -> list<bool>;
    export list-u8: func(value: list<u8>) -> list<u8>;
    export list-s8: func(value: list<s8>) -> list<s8>;
    export list-u16: func(value: list<u16>) -> list<u16>;
    export list-s16: func(value: list<s16>) -> list<s16>;
    export list-u32: func(value: list<u32>) -> list<u32>;
    export list-s32: func(value: list<s32>) -> list<s32>;
    export list-u64: func(value: list<u64>) -> list<u64>;
    export list-s64: func(value: list<s64>) -> list<s64>;
    export list-f32: func(value: list<f32>) -> list<f32>;
    export list-f64: func(value: list<f64>) -> list<f64>;
    export list-char: func(value: list<char>) -> list<char>;
    export list-string: func(value: list<string>) -> list<string>;
    export flags-1: func(value: flags-1) -> flags-1;
    export flags-8: func(value: flags-8) -> flags-8;
    export flags-9: func(value: flags-9) -> flags-9;
    export flags-16: func(value: flags-16) -> flags-16;
