datatype Option<T> = None | Some(value: T)

datatype CaptureFields = CaptureFields(input: bool, output: bool, error: bool)

function captureFields(mode: string): CaptureFields
{
  var full := (mode == "all");
  CaptureFields(full, (full || (mode == "outputs")), full)
}

lemma captureFields_ensures(mode: string)
  ensures (captureFields(mode).input == (mode == "all"))
  ensures (captureFields(mode).error == captureFields(mode).input)
  ensures (captureFields(mode).output == ((mode == "outputs") || (mode == "all")))
{
}

function retainedValue<T>(keep: bool, value: T): Option<T>
{
  if keep then
    Option.Some(value)
  else
    Option.None
}

lemma retainedValue_ensures<T>(keep: bool, value: T)
  ensures (keep ==> (match retainedValue(keep, value) { case Some(i_value) => (i_value == value) case None => false }))
  ensures (!(keep) ==> (match retainedValue(keep, value) { case Some(i_) => false case None => true }))
{
}
