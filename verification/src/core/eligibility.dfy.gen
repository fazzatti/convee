// Generated by lsc from eligibility.ts
// lsc options: string-semantics=javascript-utf16

method firstEligible<T>(items: seq<T>, start: int, eligible: (T) -> bool) returns (res: int)
  requires (0 <= start)
  requires (start <= |items|)
  ensures ((res != -1) ==> (start <= res))
  ensures (-1 <= res)
  ensures (res < |items|)
  ensures ((res >= 0) ==> eligible(items[res]))
  ensures forall k: int :: ((start <= k) ==> (k < |items|) ==> ((res == -1) || (k < res)) ==> !(eligible(items[k])))
{
  var i := start;
  while (i < |items|)
    invariant (start <= i)
    invariant (i <= |items|)
    invariant forall k: int :: ((start <= k) ==> (k < i) ==> !(eligible(items[k])))
    decreases (|items| - i)
  {
    if eligible(items[i]) {
      return i;
    }
    i := (i + 1);
  }
  return -1;
}
