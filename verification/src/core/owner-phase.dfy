datatype OwnerPhase = open | closing | dormant | closed

function phaseAfterClose(terminal: bool, reopen: bool): OwnerPhase
{
  if (terminal || !(reopen)) then
    OwnerPhase.closed
  else
    OwnerPhase.dormant
}

lemma phaseAfterClose_ensures(terminal: bool, reopen: bool)
  ensures (terminal ==> phaseAfterClose(terminal, reopen).closed?)
  ensures (!(reopen) ==> phaseAfterClose(terminal, reopen).closed?)
  ensures (!(terminal) ==> reopen ==> phaseAfterClose(terminal, reopen).dormant?)
{
}

function ownerAccepts(phase: OwnerPhase, terminal: bool): bool
{
  ((!(terminal) && (!phase.closing?)) && (!phase.closed?))
}

lemma ownerAccepts_ensures(phase: OwnerPhase, terminal: bool)
  ensures (ownerAccepts(phase, terminal) == (!(terminal) && (phase.open? || phase.dormant?)))
