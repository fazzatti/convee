// lsc options: string-semantics=javascript-utf16

type Positions = seq<int>

method retain<T>(items: seq<T>, keep: (T) -> bool) returns (res: seq<T>)
  ensures (|res| <= |items|)
  ensures forall x: T :: ((x in res) == ((x in items) && keep(x)))
  ensures exists pos: Positions :: ((((|pos| == |res|) && forall k: int :: ((0 <= k) ==> (k < |pos|) ==> (((0 <= pos[k]) && (pos[k] < |items|)) && (res[k] == items[pos[k]])))) && forall k: int :: ((0 <= k) ==> ((k + 1) < |pos|) ==> (pos[k] < pos[(k + 1)]))) && forall j: int :: ((0 <= j) ==> (j < |items|) ==> ((j in pos) == keep(items[j]))))
{
  var length := |items|;
  var kept: seq<T> := [];
  ghost var pos: Positions := [];
  var i := 0;
  while (i < length)
    invariant (0 <= i)
    invariant (i <= length)
    invariant (length == |items|)
    invariant (|kept| <= i)
    invariant forall x: T :: ((x in kept) == ((x in items[0..i]) && keep(x)))
    invariant (|pos| == |kept|)
    invariant forall k: int :: ((0 <= k) ==> (k < |pos|) ==> (((0 <= pos[k]) && (pos[k] < i)) && (kept[k] == items[pos[k]])))
    invariant forall k: int :: ((0 <= k) ==> ((k + 1) < |pos|) ==> (pos[k] < pos[(k + 1)]))
    invariant forall j: int :: ((0 <= j) ==> (j < i) ==> ((j in pos) == keep(items[j])))
    decreases (length - i)
  {
    var item := items[i];
    if keep(item) {
      kept := (kept + [item]);
      pos := (pos + [i]);
    }
    i := (i + 1);
  }
  return kept;
}
