function replyBelongs(ready: bool, active: Option<JobId>, reply: JobId): bool
{
  match active {
    case Some(i_active_val) =>
      (ready && (i_active_val.id == reply.id))
    case None =>
      false
  }
}

lemma replyBelongs_ensures(ready: bool, active: Option<JobId>, reply: JobId)
  ensures ((!(ready) || (match active { case Some(i_) => false case None => true })) ==> !(replyBelongs(ready, active, reply)))
  ensures (match active { case Some(i_active_val) => (ready ==> (replyBelongs(ready, active, reply) == (i_active_val.id == reply.id))) case None => true })
{
