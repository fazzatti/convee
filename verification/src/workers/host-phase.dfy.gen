function acceptsRequest(phase: HostPhase, kind: RequestKind): bool
{
  if kind.init? then
    phase.empty?
  else
    phase.ready?
}

lemma acceptsRequest_ensures(phase: HostPhase, kind: RequestKind)
  ensures (kind.init? ==> (acceptsRequest(phase, kind) == phase.empty?))
  ensures (kind.run? ==> (acceptsRequest(phase, kind) == phase.ready?))
{
}

function afterHostWork(phase: HostPhase): HostPhase
{
  if phase.failed? then
    HostPhase.failed
  else
    HostPhase.ready
}

lemma afterHostWork_ensures(phase: HostPhase)
  ensures (phase.failed? ==> afterHostWork(phase).failed?)
  ensures ((!phase.failed?) ==> afterHostWork(phase).ready?)
